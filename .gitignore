# =============================================================================
# Emotions & Care — gitignore reutilizable (Flutter + Firebase)
# Copiar a otros repos Flutter y ajustar la sección "Plataformas no usadas".
# =============================================================================

# --- Sistema / editor --------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/

# VS Code (settings locales; no aporta al build)
.vscode/

# --- Flutter / Dart / Pub ----------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/
**/doc/api/
**/ios/Flutter/.last_build_id

# Artefactos de release ofuscado / simbolicación
app.*.symbols
app.*.map.json
*.apk
*.aab
*.ipa
*.app

# --- Android -----------------------------------------------------------------
**/local.properties
**/.gradle/
**/captures/
/android/app/debug
/android/app/profile
/android/app/release
key.properties
**/*.keystore
**/*.jks

# --- iOS / Xcode -------------------------------------------------------------
**/Pods/
**/DerivedData/
xcuserdata/
**/.symlinks/
*.mode1v3
*.mode2v3
*.moved-aside
*.pbxuser
*.perspectivev3
**/*sync/
.sconsign.dblite
.tags*
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/ephemeral/
**/ios/Flutter/app.flx
**/ios/Flutter/app.zip
**/ios/Flutter/flutter_assets/
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/App.framework
**/ios/Runner/GeneratedPluginRegistrant.*

# --- Firebase / Node leftovers -----------------------------------------------
.firebase/
firebase-debug.log*
firebase-debug.*.log*
.dataconnect
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
.env.*
!.env.example

# --- Plataformas no usadas en este producto (Android, iOS, Web sí) -----------
# Si otro repo SÍ usa desktop, borra las tres líneas siguientes.
/windows/
/macos/
/linux/

# Stub de Flutter web que no se publica (Firebase Hosting usa build/web)
/hosting/
